  howpublished = {\url{https://git-scm.com/docs/gitignore}},
  note         = {The .keep file "reads like a .gitignore" (keep.py): last matching pattern wins, a leading "!" negates, a pattern with no slash matches at any level. Read 2026-10-20. keep.matches follows those three rules only, with Python's fnmatch, not git's full matcher (no "**", no anchoring "/").},
  code         = {experimentkit/storage/keep.py:matches},
  match        = {verified},
}

