  author  = {Reed, I. S. and Solomon, G.},
  title   = {Polynomial Codes Over Certain Finite Fields},
  journal = {Journal of the Society for Industrial and Applied Mathematics},
  year    = {1960}, volume = {8}, number = {2}, pages = {300--304},
  doi     = {10.1137/0108018},
  note    = {The error-correcting code family QR uses. Metadata confirmed from Crossref 2026-10-20; the paper was not read. QR's specific form (generator with roots alpha^0..alpha^(e-1) over GF(2^8) mod 0x11D) is ISO/IEC 18004's, not this paper's.},
  code    = {slate/index.html:QR.encode},
  match   = {candidate},
}

